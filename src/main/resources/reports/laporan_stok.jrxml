	</columnHeader>
	<detail>
		<band height="20">
				<textField textAdjust="StretchHeight">
					<reportElement style="Zebra" x="0" y="0" width="28" height="20" stretchType="RelativeToTallestObject"/>
					<box leftPadding="4" rightPadding="4">
						<bottomPen lineWidth="0.5" lineColor="#C9D6D1"/>
					</box>
					<textElement textAlignment="Center" verticalAlignment="Middle"/>
					<textFieldExpression><![CDATA[$V{REPORT_COUNT}]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="Zebra" x="28" y="0" width="62" height="20" stretchType="RelativeToTallestObject"/>
					<box leftPadding="4" rightPadding="4">
						<bottomPen lineWidth="0.5" lineColor="#C9D6D1"/>
					</box>
					<textElement textAlignment="Left" verticalAlignment="Middle"/>
					<textFieldExpression><![CDATA[$F{kode_barang}]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="Zebra" x="90" y="0" width="155" height="20" stretchType="RelativeToTallestObject"/>
					<box leftPadding="4" rightPadding="4">
						<bottomPen lineWidth="0.5" lineColor="#C9D6D1"/>
					</box>
					<textElement textAlignment="Left" verticalAlignment="Middle"/>
					<textFieldExpression><![CDATA[$F{nama}]]></textFieldExpression>
				</textField>
				<textField pattern="'Rp '#,##0" textAdjust="StretchHeight">
					<reportElement style="Zebra" x="245" y="0" width="70" height="20" stretchType="RelativeToTallestObject"/>
					<box leftPadding="4" rightPadding="4">
						<bottomPen lineWidth="0.5" lineColor="#C9D6D1"/>
					</box>
					<textElement textAlignment="Right" verticalAlignment="Middle"/>
					<textFieldExpression><![CDATA[$F{harga}]]></textFieldExpression>
				</textField>
				<textField pattern="#,##0" textAdjust="StretchHeight">
					<reportElement style="Zebra" x="315" y="0" width="45" height="20" stretchType="RelativeToTallestObject"/>
					<box leftPadding="4" rightPadding="4">
						<bottomPen lineWidth="0.5" lineColor="#C9D6D1"/>
					</box>
					<textElement textAlignment="Center" verticalAlignment="Middle"/>
					<textFieldExpression><![CDATA[$F{stok}]]></textFieldExpression>
				</textField>
				<textField pattern="#,##0" textAdjust="StretchHeight">
					<reportElement style="Zebra" x="360" y="0" width="55" height="20" stretchType="RelativeToTallestObject"/>
					<box leftPadding="4" rightPadding="4">
						<bottomPen lineWidth="0.5" lineColor="#C9D6D1"/>
					</box>
					<textElement textAlignment="Center" verticalAlignment="Middle"/>
					<textFieldExpression><![CDATA[$F{terjual}]]></textFieldExpression>
				</textField>
				<textField pattern="'Rp '#,##0" textAdjust="StretchHeight">
					<reportElement style="Zebra" x="415" y="0" width="70" height="20" stretchType="RelativeToTallestObject"/>
					<box leftPadding="4" rightPadding="4">
						<bottomPen lineWidth="0.5" lineColor="#C9D6D1"/>
					</box>
					<textElement textAlignment="Right" verticalAlignment="Middle"/>
					<textFieldExpression><![CDATA[$F{nilai_stok}]]></textFieldExpression>
				</textField>
				<textField textAdjust="StretchHeight">
					<reportElement style="Status" x="485" y="0" width="50" height="20" stretchType="RelativeToTallestObject"/>
					<box leftPadding="4" rightPadding="4">
						<bottomPen lineWidth="0.5" lineColor="#C9D6D1"/>
					</box>
					<textElement textAlignment="Center" verticalAlignment="Middle"/>
					<textFieldExpression><![CDATA[$F{stok} <= 0 ? "Habis" : ($F{stok} <= $P{BATAS_MENIPIS} ? "Menipis" : "Aman")]]></textFieldExpression>
				</textField>
		</band>
	</detail>
