					<textElement textAlignment="Center" verticalAlignment="Middle"/>
					<textFieldExpression><![CDATA[$V{TOTAL_TERJUAL}]]></textFieldExpression>
				</textField>
				<textField pattern="'Rp '#,##0">
					<reportElement style="TeksPutihTebal" x="415" y="6" width="70" height="24"/>
					<box leftPadding="4" rightPadding="4"/>
					<textElement textAlignment="Right" verticalAlignment="Middle"/>
					<textFieldExpression><![CDATA[$V{TOTAL_NILAI}]]></textFieldExpression>
				</textField>
				<textField>
					<reportElement style="Miring" x="0" y="38" width="535" height="14"/>
					<textElement textAlignment="Left" verticalAlignment="Middle"/>
					<textFieldExpression><![CDATA["Keterangan status: Habis = stok 0; Menipis = stok 1 sampai " + $P{BATAS_MENIPIS} + "; Aman = stok di atas " + $P{BATAS_MENIPIS} + "."]]></textFieldExpression>
				</textField>
				<staticText>
					<reportElement style="Miring" x="0" y="52" width="535" height="14">
						<printWhenExpression><![CDATA[$V{JUMLAH_JENIS} == 0]]></printWhenExpression>
					</reportElement>
					<textElement textAlignment="Center" verticalAlignment="Middle"/>
					<text><![CDATA[Belum ada data barang.]]></text>
				</staticText>
		</band>
	</summary>
