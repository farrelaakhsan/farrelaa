			<staticText>
				<reportElement style="HeadTabel" x="360" y="0" width="55" height="24"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<text><![CDATA[Terjual]]></text>
			</staticText>
			<staticText>
				<reportElement style="HeadTabel" x="415" y="0" width="70" height="24"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"/>
				<text><![CDATA[Nilai Stok]]></text>
			</staticText>
			<staticText>
				<reportElement style="HeadTabel" x="485" y="0" width="50" height="24"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<text><![CDATA[Status]]></text>
			</staticText>
