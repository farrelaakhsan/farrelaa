<?xml version="1.0" encoding="UTF-8"?>
<!-- Dibuat untuk Jaspersoft Studio 6.21 / JasperReports 6.21.5 (database tk_db) -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="laporan_stok" language="java" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30" whenNoDataType="AllSectionsNoDetail">
	<property name="net.sf.jasperreports.awt.ignore.missing.font" value="true"/>
	<!-- Warna: hijau tua #14493D, hijau #1F6F5C, aksen #F2A93B, baris selang-seling #EAF3F0 -->
	<style name="Dasar" isDefault="true" forecolor="#222222" fontName="Arial" fontSize="9" pdfFontName="Helvetica" pdfEncoding="Cp1252" isPdfEmbedded="false"/>
	<style name="Tebal" style="Dasar" isBold="true" pdfFontName="Helvetica-Bold"/>
	<style name="Miring" style="Dasar" forecolor="#555555" isItalic="true" pdfFontName="Helvetica-Oblique"/>
	<style name="Abu" style="Dasar" forecolor="#555555"/>
	<style name="JudulBesar" style="Dasar" forecolor="#FFFFFF" fontSize="20" isBold="true" pdfFontName="Helvetica-Bold"/>
	<style name="JudulSedang" style="Dasar" forecolor="#FFFFFF" fontSize="15" isBold="true" pdfFontName="Helvetica-Bold"/>
	<style name="TeksPutih" style="Dasar" forecolor="#FFFFFF"/>
	<style name="TeksPutihTebal" style="Dasar" forecolor="#FFFFFF" isBold="true" pdfFontName="Helvetica-Bold"/>
	<style name="HeadTabel" style="Tebal" mode="Opaque" forecolor="#FFFFFF" backcolor="#1F6F5C"/>
	<style name="Zebra" style="Dasar" mode="Opaque" backcolor="#FFFFFF">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
			<style backcolor="#EAF3F0"/>
		</conditionalStyle>
	</style>
	<style name="KpiLabel" style="Dasar" forecolor="#555555" fontSize="8"/>
	<style name="KpiNilai" style="Dasar" forecolor="#14493D" fontSize="14" isBold="true" pdfFontName="Helvetica-Bold"/>
	<style name="Status" style="Zebra">
		<conditionalStyle>
			<conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
			<style backcolor="#EAF3F0"/>
		</conditionalStyle>
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{stok} <= 0]]></conditionExpression>
			<style forecolor="#C62828" isBold="true" pdfFontName="Helvetica-Bold"/>
		</conditionalStyle>
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{stok} > 0 && $F{stok} <= $P{BATAS_MENIPIS}]]></conditionExpression>
			<style forecolor="#E65100" isBold="true" pdfFontName="Helvetica-Bold"/>
		</conditionalStyle>
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{stok} > $P{BATAS_MENIPIS}]]></conditionExpression>
			<style forecolor="#2E7D32" isBold="true" pdfFontName="Helvetica-Bold"/>
		</conditionalStyle>
	</style>

	<parameter name="DARI" class="java.sql.Timestamp">
		<parameterDescription><![CDATA[Awal periode (termasuk)]]></parameterDescription>
		<defaultValueExpression><![CDATA[java.sql.Timestamp.valueOf("2026-01-01 00:00:00")]]></defaultValueExpression>
	</parameter>
	<parameter name="SAMPAI" class="java.sql.Timestamp">
		<parameterDescription><![CDATA[Akhir periode (tidak termasuk; Java mengirim tanggal akhir + 1 hari)]]></parameterDescription>
		<defaultValueExpression><![CDATA[java.sql.Timestamp.valueOf("2027-01-01 00:00:00")]]></defaultValueExpression>
	</parameter>
	<parameter name="PERIODE" class="java.lang.String">
		<defaultValueExpression><![CDATA["Semua periode"]]></defaultValueExpression>
	</parameter>
	<parameter name="BATAS_MENIPIS" class="java.lang.Integer">
		<parameterDescription><![CDATA[Stok sama dengan atau di bawah angka ini ditandai "Menipis"]]></parameterDescription>
		<defaultValueExpression><![CDATA[Integer.valueOf(5)]]></defaultValueExpression>
	</parameter>
	<parameter name="NAMA_TOKO" class="java.lang.String">
		<defaultValueExpression><![CDATA["Toko Kelontong"]]></defaultValueExpression>
	</parameter>
	<parameter name="SUB_TOKO" class="java.lang.String">
		<defaultValueExpression><![CDATA["Manajemen Stok dan Penjualan"]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[SELECT b.kode_barang, b.nama, b.harga, b.stok,
       b.harga * b.stok AS nilai_stok,
       CAST(COALESCE((SELECT SUM(d.jumlah)
                      FROM detail_transaksi d
                      JOIN transaksi t ON t.id = d.id_transaksi
                      WHERE d.id_barang = b.id
                        AND t.tanggal >= $P{DARI} AND t.tanggal < $P{SAMPAI}), 0) AS SIGNED) AS terjual
FROM barang b
ORDER BY b.nama]]>
	</queryString>
	<field name="kode_barang" class="java.lang.String"/>
	<field name="nama" class="java.lang.String"/>
	<field name="harga" class="java.lang.Long"/>
	<field name="stok" class="java.lang.Integer"/>
	<field name="nilai_stok" class="java.lang.Long"/>
	<field name="terjual" class="java.lang.Long"/>
	<variable name="JUMLAH_JENIS" class="java.lang.Long" calculation="Count">
		<variableExpression><![CDATA[$F{kode_barang}]]></variableExpression>
		<initialValueExpression><![CDATA[Long.valueOf(0)]]></initialValueExpression>
	</variable>
	<variable name="TOTAL_STOK" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{stok}]]></variableExpression>
		<initialValueExpression><![CDATA[Integer.valueOf(0)]]></initialValueExpression>
	</variable>
	<variable name="TOTAL_TERJUAL" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{terjual}]]></variableExpression>
		<initialValueExpression><![CDATA[Long.valueOf(0)]]></initialValueExpression>
	</variable>
	<variable name="TOTAL_NILAI" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{nilai_stok}]]></variableExpression>
		<initialValueExpression><![CDATA[Long.valueOf(0)]]></initialValueExpression>
	</variable>
	<title>
		<band height="156">
				<rectangle radius="0">
					<reportElement mode="Opaque" x="0" y="0" width="535" height="70" forecolor="#1F6F5C" backcolor="#1F6F5C"/>
					<graphicElement>
						<pen lineWidth="0"/>
					</graphicElement>
				</rectangle>
				<rectangle radius="0">
					<reportElement mode="Opaque" x="0" y="70" width="535" height="4" forecolor="#F2A93B" backcolor="#F2A93B"/>
					<graphicElement>
						<pen lineWidth="0"/>
					</graphicElement>
				</rectangle>
				<textField>
					<reportElement style="JudulBesar" x="20" y="12" width="300" height="26"/>
					<textElement textAlignment="Left" verticalAlignment="Middle"/>
					<textFieldExpression><![CDATA[$P{NAMA_TOKO}]]></textFieldExpression>
				</textField>
				<textField>
					<reportElement style="TeksPutih" x="20" y="42" width="300" height="14"/>
					<textElement textAlignment="Left" verticalAlignment="Middle"/>
					<textFieldExpression><![CDATA[$P{SUB_TOKO}]]></textFieldExpression>
				</textField>
				<staticText>
					<reportElement style="JudulSedang" x="285" y="14" width="230" height="24"/>
					<textElement textAlignment="Right" verticalAlignment="Middle"/>
					<text><![CDATA[LAPORAN STOK BARANG]]></text>
				</staticText>
				<textField>
					<reportElement style="TeksPutih" x="235" y="42" width="280" height="14"/>
					<textElement textAlignment="Right" verticalAlignment="Middle"/>
					<textFieldExpression><![CDATA["Penjualan periode: " + $P{PERIODE}]]></textFieldExpression>
				</textField>
				<rectangle radius="6">
					<reportElement mode="Opaque" x="0" y="92" width="171" height="50" forecolor="#1F6F5C" backcolor="#EAF3F0"/>
					<graphicElement>
						<pen lineWidth="0.75" lineColor="#1F6F5C"/>
					</graphicElement>
				</rectangle>
				<staticText>
					<reportElement style="KpiLabel" x="10" y="99" width="151" height="12"/>
					<textElement textAlignment="Left" verticalAlignment="Middle"/>
					<text><![CDATA[Jenis Barang]]></text>
				</staticText>
				<textField pattern="#,##0" evaluationTime="Report">
					<reportElement style="KpiNilai" x="10" y="113" width="151" height="22"/>
					<textElement textAlignment="Left" verticalAlignment="Middle"/>
					<textFieldExpression><![CDATA[$V{JUMLAH_JENIS}]]></textFieldExpression>
				</textField>
				<rectangle radius="6">
					<reportElement mode="Opaque" x="182" y="92" width="171" height="50" forecolor="#1F6F5C" backcolor="#EAF3F0"/>
					<graphicElement>
						<pen lineWidth="0.75" lineColor="#1F6F5C"/>
					</graphicElement>
				</rectangle>
				<staticText>
					<reportElement style="KpiLabel" x="192" y="99" width="151" height="12"/>
					<textElement textAlignment="Left" verticalAlignment="Middle"/>
					<text><![CDATA[Total Unit Stok]]></text>
				</staticText>
				<textField pattern="#,##0" evaluationTime="Report">
					<reportElement style="KpiNilai" x="192" y="113" width="151" height="22"/>
					<textElement textAlignment="Left" verticalAlignment="Middle"/>
					<textFieldExpression><![CDATA[$V{TOTAL_STOK}]]></textFieldExpression>
				</textField>
				<rectangle radius="6">
					<reportElement mode="Opaque" x="364" y="92" width="171" height="50" forecolor="#1F6F5C" backcolor="#EAF3F0"/>
					<graphicElement>
						<pen lineWidth="0.75" lineColor="#1F6F5C"/>
					</graphicElement>
				</rectangle>
				<staticText>
					<reportElement style="KpiLabel" x="374" y="99" width="151" height="12"/>
					<textElement textAlignment="Left" verticalAlignment="Middle"/>
					<text><![CDATA[Nilai Total Stok]]></text>
				</staticText>
				<textField pattern="'Rp '#,##0" evaluationTime="Report">
					<reportElement style="KpiNilai" x="374" y="113" width="151" height="22"/>
					<textElement textAlignment="Left" verticalAlignment="Middle"/>
					<textFieldExpression><![CDATA[$V{TOTAL_NILAI}]]></textFieldExpression>
				</textField>
		</band>
	</title>
	<columnHeader>
		<band height="24">
			<staticText>
				<reportElement style="HeadTabel" x="0" y="0" width="28" height="24"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<text><![CDATA[No]]></text>
			</staticText>
			<staticText>
				<reportElement style="HeadTabel" x="28" y="0" width="62" height="24"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<text><![CDATA[Kode]]></text>
			</staticText>
			<staticText>
				<reportElement style="HeadTabel" x="90" y="0" width="155" height="24"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Left" verticalAlignment="Middle"/>
				<text><![CDATA[Nama Barang]]></text>
			</staticText>
			<staticText>
				<reportElement style="HeadTabel" x="245" y="0" width="70" height="24"/>
				<box leftPadding="4" rightPadding="4"/>
