	<summary>
		<band height="70">
				<rectangle radius="0">
					<reportElement mode="Opaque" x="0" y="6" width="535" height="24" forecolor="#14493D" backcolor="#14493D"/>
					<graphicElement>
						<pen lineWidth="0"/>
					</graphicElement>
				</rectangle>
