	<summary>
		<band height="64">
				<rectangle radius="0">
					<reportElement mode="Opaque" x="0" y="6" width="535" height="24" forecolor="#14493D" backcolor="#14493D"/>
					<graphicElement>
						<pen lineWidth="0"/>
					</graphicElement>
				</rectangle>
				<staticText>
					<reportElement style="TeksPutihTebal" x="0" y="6" width="225" height="24"/>
					<box leftPadding="8"/>
					<textElement textAlignment="Left" verticalAlignment="Middle"/>
					<text><![CDATA[TOTAL]]></text>
				</staticText>
				<textField pattern="#,##0">
					<reportElement style="TeksPutihTebal" x="225" y="6" width="50" height="24"/>
					<textElement textAlignment="Center" verticalAlignment="Middle"/>
					<textFieldExpression><![CDATA[$V{TOTAL_ITEM}]]></textFieldExpression>
				</textField>
				<textField pattern="'Rp '#,##0">
					<reportElement style="TeksPutihTebal" x="275" y="6" width="90" height="24"/>
					<box leftPadding="4" rightPadding="4"/>
					<textElement textAlignment="Right" verticalAlignment="Middle"/>
					<textFieldExpression><![CDATA[$V{TOTAL_PENJUALAN}]]></textFieldExpression>
				</textField>
				<staticText>
					<reportElement style="Miring" x="0" y="38" width="535" height="18">
						<printWhenExpression><![CDATA[$V{JUMLAH_TRANSAKSI} == 0]]></printWhenExpression>
					</reportElement>
					<textElement textAlignment="Center" verticalAlignment="Middle"/>
					<text><![CDATA[Tidak ada transaksi pada periode ini.]]></text>
				</staticText>
		</band>
	</summary>
