			<staticText>
				<reportElement style="HeadTabel" x="275" y="0" width="90" height="24"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"/>
				<text><![CDATA[Total]]></text>
			</staticText>
			<staticText>
				<reportElement style="HeadTabel" x="365" y="0" width="85" height="24"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"/>
				<text><![CDATA[Bayar]]></text>
			</staticText>
			<staticText>
				<reportElement style="HeadTabel" x="450" y="0" width="85" height="24"/>
				<box leftPadding="4" rightPadding="4"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"/>
				<text><![CDATA[Kembalian]]></text>
			</staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="20">
				<textField>
					<reportElement style="Zebra" x="0" y="0" width="30" height="20"/>
					<box leftPadding="4" rightPadding="4">
						<bottomPen lineWidth="0.5" lineColor="#C9D6D1"/>
					</box>
					<textElement textAlignment="Center" verticalAlignment="Middle"/>
					<textFieldExpression><![CDATA[$V{REPORT_COUNT}]]></textFieldExpression>
				</textField>
				<textField>
					<reportElement style="Zebra" x="30" y="0" width="85" height="20"/>
					<box leftPadding="4" rightPadding="4">
						<bottomPen lineWidth="0.5" lineColor="#C9D6D1"/>
					</box>
					<textElement textAlignment="Left" verticalAlignment="Middle"/>
					<textFieldExpression><![CDATA["INV-" + String.format("%06d", $F{id})]]></textFieldExpression>
				</textField>
				<textField pattern="dd-MM-yyyy HH:mm">
					<reportElement style="Zebra" x="115" y="0" width="110" height="20"/>
					<box leftPadding="4" rightPadding="4">
						<bottomPen lineWidth="0.5" lineColor="#C9D6D1"/>
					</box>
					<textElement textAlignment="Left" verticalAlignment="Middle"/>
					<textFieldExpression><![CDATA[$F{tanggal}]]></textFieldExpression>
				</textField>
				<textField pattern="#,##0">
					<reportElement style="Zebra" x="225" y="0" width="50" height="20"/>
					<box leftPadding="4" rightPadding="4">
						<bottomPen lineWidth="0.5" lineColor="#C9D6D1"/>
					</box>
					<textElement textAlignment="Center" verticalAlignment="Middle"/>
					<textFieldExpression><![CDATA[$F{jumlah_item}]]></textFieldExpression>
				</textField>
				<textField pattern="'Rp '#,##0">
					<reportElement style="Zebra" x="275" y="0" width="90" height="20"/>
					<box leftPadding="4" rightPadding="4">
						<bottomPen lineWidth="0.5" lineColor="#C9D6D1"/>
					</box>
					<textElement textAlignment="Right" verticalAlignment="Middle"/>
					<textFieldExpression><![CDATA[$F{total}]]></textFieldExpression>
				</textField>
				<textField pattern="'Rp '#,##0">
					<reportElement style="Zebra" x="365" y="0" width="85" height="20"/>
